{
  "name": "mail-chatbot",
  "version": "1.0.0",
  "description": "Gmail AI chatbot with LangChain and OpenAI",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.client.json",
    "build:server": "tsup",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "dev": "npm run build:client && concurrently \"tsx watch src/server.ts\" \"tsc -p tsconfig.client.json --watch\""
  },
  "keywords": [
    "gmail",
    "chatbot",
    "langchain",
    "openai",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^0.3.42",
    "@langchain/openai": "^0.4.5",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "langchain": "^0.3.19",
    "mongoose": "^8.9.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
